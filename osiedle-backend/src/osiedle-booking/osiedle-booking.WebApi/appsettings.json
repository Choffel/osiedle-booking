{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Identity": {
    "Lockout": {
      "AllowedForNewUsers": true,
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutMinutes": 15
    },

    "JwtSettings": {
      "Issuer": "OsiedleBooking",
      "Audience": "OsiedleBookingClients",
      "ExpiryMinutes": 60
    }
  }
}
